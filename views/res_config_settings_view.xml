<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_autoinfo_membership_report_context_fix" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.autoinfo.membership.report.context.fix</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="85"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="AUTO-INFO Membership" string="AUTO-INFO Membership" data-key="autoinfo_membership_report_context_fix" groups="base.group_system">
                    <h2>AUTO-INFO Membership</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="autoinfo_membership_report_context_fix_enabled"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="autoinfo_membership_report_context_fix_enabled" class="o_form_label">Enable Membership Report Context Fix</label>
                                <div class="text-muted">
                                    Prevents invalid date domains caused by default context values on Members Analysis.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
